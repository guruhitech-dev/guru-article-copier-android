<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/paper" android:orientation="vertical"
    android:paddingStart="20dp" android:paddingTop="16dp" android:paddingEnd="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="@color/ink"
        android:textSize="28sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
        <EditText android:id="@+id/url_input" android:layout_width="0dp" android:layout_height="52dp"
            android:layout_weight="1" android:background="@drawable/input_background"
            android:hint="@string/url_hint" android:imeOptions="actionGo" android:inputType="textUri"
            android:maxLines="1" android:textColor="@color/ink" android:textSize="15sp" />
        <Button android:id="@+id/read_button" android:layout_width="wrap_content" android:layout_height="52dp"
            android:layout_marginStart="8dp" android:text="@string/read" />
    </LinearLayout>

    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/copy_button" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:enabled="false" android:text="@string/copy_all" />
        <Button android:id="@+id/open_button" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:enabled="false" android:text="@string/open_original" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:paddingTop="12dp" android:paddingBottom="24dp">
        <TextView android:id="@+id/article_text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:lineSpacingExtra="6dp"
            android:text="@string/welcome" android:textColor="@color/ink" android:textIsSelectable="true"
            android:textSize="18sp" />
    </ScrollView>
</LinearLayout>

